# Apache (shared hosting such as Hostinger). Compression + caching for the Vite build.

# --- Types: older Apache builds do not know AVIF ---
AddType image/avif .avif

# --- Compression: brotli where available, gzip otherwise ---
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# --- Caching ---
<IfModule mod_headers.c>
  # hashed build output never changes under the same name
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # images and fonts: a year, immutable. RULE: never overwrite an image in place. A changed image gets a new
  # file name (e.g. -v2, -v3) and its references are updated, so a cached copy can never go stale.
  <FilesMatch "\.(webp|avif|png|jpg|jpeg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # the favicon is requested by fixed name, so it keeps a shorter life
  <FilesMatch "^favicon\.ico$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # pages, the sitemap and robots must always be revalidated so new deploys are picked up
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Pages and errors ---
# Every page is a real file in the build (dist/<page>/index.html). Apache's DirectorySlash sends /plants to the
# canonical /plants/; /index.html goes to /; anything that is not a page gets the build's 404.html with a 404 status.
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>
